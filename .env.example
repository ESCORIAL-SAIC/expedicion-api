# Postgres: base ESCORIAL. Host y credenciales de produccion, en el gestor de secretos.
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=

# SQL Server: base Etiquetas (Suipacha). Host y credenciales, en el gestor de secretos.
MSSQL_HOST=
MSSQL_PORT=1433
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=

# HTTP server
PORT=3000
LOG_LEVEL=info

# Imagen a desplegar. SIN esta variable el compose usa :latest, que es el ultimo release de
# main -- no lo ultimo mergeado. Conviene fijar la version exacta para saber que esta corriendo
# y para que un `docker compose up` de otra persona no cambie de version sin aviso.
#   IMAGE_TAG=0.2.0-rc.2   version exacta (recomendado)
#   IMAGE_TAG=dev          ultimo prerelease, tag movil
#   IMAGE_TAG=latest       ultimo release estable de main
IMAGE_TAG=latest
